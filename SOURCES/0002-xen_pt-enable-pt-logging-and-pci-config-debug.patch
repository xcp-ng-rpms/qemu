From 30c23da0db74efe617331e8393df863af7c02d0d Mon Sep 17 00:00:00 2001
From: Yann Sionneau <yann.sionneau@vates.tech>
Date: Tue, 30 Jun 2026 10:42:50 +0200
Subject: [PATCH 2/4] xen_pt: enable pt logging and pci config debug

---
 hw/xen/xen_pt.c | 3 +++
 hw/xen/xen_pt.h | 2 ++
 2 files changed, 5 insertions(+)

diff --git a/hw/xen/xen_pt.c b/hw/xen/xen_pt.c
index 027190fa44..c36c1e56ea 100644
--- a/hw/xen/xen_pt.c
+++ b/hw/xen/xen_pt.c
@@ -52,6 +52,9 @@
  *         - Set entry->pirq to '-1'.
  */
 
+#define XEN_PT_LOGGING_ENABLED
+#define XEN_PT_DEBUG_PCI_CONFIG_ACCESS
+
 #include "qemu/osdep.h"
 #include "qapi/error.h"
 #include <sys/ioctl.h>
diff --git a/hw/xen/xen_pt.h b/hw/xen/xen_pt.h
index c74c4678f2..c7259dc572 100644
--- a/hw/xen/xen_pt.h
+++ b/hw/xen/xen_pt.h
@@ -12,6 +12,8 @@ void xen_igd_gfx_pt_set(bool value, Error **errp);
 void xen_pt_log(const PCIDevice *d, const char *f, ...) GCC_FMT_ATTR(2, 3);
 
 #define XEN_PT_ERR(d, _f, _a...) xen_pt_log(d, "%s: Error: "_f, __func__, ##_a)
+#define XEN_PT_LOGGING_ENABLED
+#define XEN_PT_DEBUG_PCI_CONFIG_ACCESS
 
 #ifdef XEN_PT_LOGGING_ENABLED
 #  define XEN_PT_LOG(d, _f, _a...)  xen_pt_log(d, "%s: " _f, __func__, ##_a)
